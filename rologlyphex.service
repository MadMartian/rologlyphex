[Unit]
Description=Rologlyphex - Macropad Layout Overlay
After=graphical-session.target

[Service]
Type=simple
# No --config: the daemon defaults to ~/.config/rologlyphex/layers.toml.
ExecStart=/usr/local/bin/rologlyphex
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
